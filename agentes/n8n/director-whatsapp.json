    {
      "name": "Partir en mensajes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "jsCode": "const t = ($input.first().json.output || 'No pude generar respuesta.').trim();\nconst to = $('Validar remitente').first().json.from;\nconst partes = []; let resto = t;\nwhile (resto.length > 1500) { let i = resto.lastIndexOf('\\n', 1500); if (i < 500) i = 1500; partes.push(resto.slice(0, i)); resto = resto.slice(i).trim(); }\npartes.push(resto);\nreturn partes.map(p => ({ json: { to, body: p } }));"
      }
    },
