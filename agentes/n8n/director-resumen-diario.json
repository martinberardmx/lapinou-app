        "jsCode": "const now = $now.setZone('America/Mexico_City');\nconst ayer = now.minus({days:1});\nconst semPasada = ayer.minus({days:7});\nreturn [{json:{ayer: ayer.toISODate(), ayerTexto: ayer.setLocale('es').toFormat(\"cccc d 'de' LLLL\"), semPasada: semPasada.toISODate(), inicio30: ayer.minus({days:29}).toISODate()}}];"
