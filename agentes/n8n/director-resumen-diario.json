        "sendTo": "cafelapinou@gmail.com",
        "subject": "=☕ Resumen Lapinou — {{ $json.ayerTexto }}",
        "emailType": "text",
        "message": "={{ $json.texto }}",
        "options": {
          "appendAttribution": false
        }
      }
    }
